  * id : UUID <<PK>>
  --
  code : VARCHAR(50)
  name : VARCHAR(100)
}

entity "notification_statuses" as nstatuses {
  * id : UUID <<PK>>
  --
  code : VARCHAR(50)
  name : VARCHAR(100)
}

entity "device_push_tokens" as tokens {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  token : TEXT
  platform : VARCHAR(50)
  is_active : BOOLEAN
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity email_verification_codes {
* id : UUID <<PK>>
--
user_id : UUID <<FK>>
code_hast : TEXT
expires_at : TIMESTAMPTZ
consumed_at : TIMESTAMPTZ
