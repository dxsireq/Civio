' ============================================================
' Рисунок 3 – Обобщённая схема связей сущностей
' ============================================================
@startuml fig3_overview
skinparam linetype ortho
skinparam ranksep 20
skinparam nodesep 120
skinparam entity {
  BackgroundColor #EEF4FF
  BorderColor #5B8DEF
  FontName Arial
}
skinparam arrow {
  Color #555555
}
hide circle
hide methods

entity "users" as users {
  * id : UUID <<PK>>
  --
  email : VARCHAR
  first_name : VARCHAR
  last_name : VARCHAR
  is_active : BOOLEAN
}

entity "organizations" as orgs {
  * id : UUID <<PK>>
  --
  name : VARCHAR
  status_id : UUID <<FK>>
  owner_user_id : UUID <<FK>>
}

entity "employees" as emp {
  * id : UUID <<PK>>
  --
  organization_id : UUID <<FK>>
  user_id : UUID <<FK>>
}

entity "services" as svc {
  * id : UUID <<PK>>
  --
  organization_id : UUID <<FK>>
  category_id : UUID <<FK>>
}

entity "bookings" as book {
  * id : UUID <<PK>>
  --
  citizen_id : UUID <<FK>>
  organization_id : UUID <<FK>>
  employee_id : UUID <<FK>>
  service_id : UUID <<FK>>
  slot_id : UUID <<FK>>
  status_id : UUID <<FK>>
}

entity "notifications" as notif {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  booking_id : UUID <<FK>>
}

users ||--o{ orgs
users ||--o{ emp
users ||--o{ book
users ||--o{ notif
orgs ||--o{ emp
