Email__EnableSsl=

# Base URL веб-клиента для ссылок в письмах (инвайты: {base}/invite/{token}).
# Демо через туннель: https://<random>.trycloudflare.com
# Прод (VPS): https://194-226-97-71.sslip.io
App__WebClientBaseUrl=

# --- Прод-деплой (VPS). Локально оставить пустыми/закомментированными. ---
# Домен Caddy: задан -> auto-TLS на :443. Пусто -> :8080 без TLS (локалка).
SITE_ADDRESS=
# Хостинг-окружение API. Прод: Production (скрывает детальные ошибки).
ASPNETCORE_ENVIRONMENT=
# JWT-секрет: ОБЯЗАТЕЛЬНО сменить в проде. Сгенерить: openssl rand -base64 48
Jwt__Secret=
